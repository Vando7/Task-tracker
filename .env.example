# Copy to .env. Every variable is validated by Zod at boot in
# apps/server/src/env.ts, so a typo fails fast and loudly instead of at 3am.

# ---------------------------------------------------------------- required

# Signing/encryption secret for session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-plus-random-bytes

# ---------------------------------------------------------------- optional

NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# SQLite file, relative to the repository root (or absolute).
# Deleting it and re-running `pnpm db:migrate && pnpm db:seed` is the reset button.
DATABASE_URL=file:data/app.db

# Where uploaded avatars are written, relative to the repository root.
UPLOAD_DIR=uploads

# Public origin, used to build links in verification and reset emails.
APP_ORIGIN=http://localhost:5173

# --- Web Push -------------------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Leave unset to run without push. The app degrades to in-app notifications
# only; nothing breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# How often the notification scheduler tick runs. One in-process interval, no
# broker and no worker container.
SCHEDULER_INTERVAL_MS=120000

# --- Mail -----------------------------------------------------------------
# In development, verification and reset links are printed to the server
# console — there is no SMTP server and no Mailpit container.
# Set to `smtp` in production and fill in the rest.
MAIL_TRANSPORT=console

# Skip email verification: accounts work the moment they are created, and an
# existing unverified account is verified on its next successful login.
#
# Defaults to ON in development (NODE_ENV=development) — chasing a link out of a
# server log buys nothing against a local database. The server refuses to boot
# with this enabled in production.
# AUTO_VERIFY_EMAIL=true
